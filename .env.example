# Environment Configuration for Are You Ghost
# Copy this file to .env and update with your local values

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/areyoughost

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Logging
RUST_LOG=info,areyoughost_core=debug,areyoughost_server=debug

# Application Settings
MAX_PLAYERS_PER_ROOM=16
SESSION_TIMEOUT_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=30

# Network Settings
BANDWIDTH_LIMIT_MBPS=1
ENABLE_COMPRESSION=false

# Development
RUST_BACKTRACE=1
